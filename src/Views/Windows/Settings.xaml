<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- General Settings -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="General"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <CheckBox Content="Start with system" />
                <CheckBox Content="Minimize to tray" />
                <CheckBox Content="Check for updates" />
            </StackPanel>

            <!-- Appearance Settings -->
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Appearance"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <ComboBox PlaceholderText="Theme" />
                <Slider Minimum="0.1" Maximum="1" Value="0.9" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Reset"
                        Margin="0,0,12,0"
                        Width="80"/>
                <Button Content="Save"
                        Width="80"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>