<UserControl
    x:Class="TopNotch.Views.Windows.Island"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TopNotch.Views.Windows">

    <Border
        Background="{StaticResource IslandBrush}"
        BorderBrush="{StaticResource HighlightColor}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Compact Header -->
            <StackPanel
                x:Name="CompactHeader"
                Grid.Row="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,0,8"
                Spacing="4">

                <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryColor}"/>

                <TextBlock
                    x:Name="TimeDisplay"
                    Text="{Binding CurrentTime}"
                    Foreground="{StaticResource TextColor}"/>
            </StackPanel>

            <!-- Expanded Content -->
            <Grid
                x:Name="ExpandedContent"
                Grid.Row="1"
                Visibility="Collapsed">

                <ContentPresenter
                    Content="{Binding CurrentView}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>